  "html": "<h1 class=\"dance-show-title\">Boxing Day Special</h1>\n<p class=\"dance-show-choreographer\">by: <strong><a href=\"/choreographers/52\">Sarah Kaiser</a></strong></p>\n<p class=\"dance-show-formation\">formation: Becket </p>\n<div class=\"dance-show-preamble\"><div class='contra-markdown-block'></div></div>\n<table class=\"table table-bordered table-condensed contra-table-nonfluid\">\n         <tr class=\"a1b1 \">\n             <td>A1</td>\n             <td class=dance-show-beats>2</td>\n             <td><div class=\"show-figure\">slide left along set</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>6</td>\n             <td><div class=\"show-figure\">circle left 3 places</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">neighbors swing</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td>A2</td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">long lines forward &amp; back</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td></td>\n             <td class=dance-show-beats>2</td>\n             <td><div class=\"show-figure\">gentlespoons allemande left ½</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td></td>\n             <td class=dance-show-beats>6</td>\n             <td><div class=\"show-figure\">partners allemande right ¾ to long wave, <u>gentlespoons</u> face in</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td>B1</td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">balance &amp;  box circulate - gentlespoons cross while ladles loop right</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">balance &amp;  box circulate - ladles cross while gentlespoons loop right ⁋</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 dance-show-long-figure\">\n             <td>B2</td>\n             <td class=dance-show-beats>16</td>\n             <td><div class=\"show-figure\">partners balance &amp; swing</div>\n</td></tr>\n</tr></table>\n<div class=\"dance-show-notes\"><div class='contra-markdown-block'></div></div>\n<p class=\"dance-show-publish\">\n            shared everywhere\n          </p>\n"
