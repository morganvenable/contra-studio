{"schema":"contra-studio/contradb-interpretation","version":1,"sourceSnapshotId":"contradb:1844:f5375c54aafa7cb8","snapshot":{"schema":"contra-studio/contradb-snapshot","version":1,"sourceUrl":"https://contradb.com/dances/1844","retrievedAt":"2026-10-20T06:20:26.093Z","html":"<h1 class=\"dance-show-title\">Through the Looking Glass</h1>\n<p class=\"dance-show-choreographer\">by: <strong><a href=\"/choreographers/2\">Cary Ravitz</a></strong></p>\n<p class=\"dance-show-formation\">formation: Becket </p>\n<div class=\"dance-show-preamble\"><div class='contra-markdown-block'></div></div>\n<table class=\"table table-bordered table-condensed contra-table-nonfluid\">\n         <tr class=\"a1b1 \">\n             <td>A1</td>\n             <td class=dance-show-beats>6</td>\n             <td><div class=\"show-figure\">circle left 3 places</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>2</td>\n             <td><div class=\"show-figure\">pass through ⁋</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">next neighbors swing</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td>A2</td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">gentlespoons start a half hey - lefts in center, rights on ends</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">gentlespoons allemande left 1½, scoop up <u>partners</u></div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td>B1</td>\n             <td class=dance-show-beats>4</td>\n             <td><div class=\"show-figure\">star promenade left ½</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>4</td>\n             <td><div class=\"show-figure\">butterfly whirl</div>\n</td></tr>\n</tr>         <tr class=\"a1b1 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">ladles start a half hey - rights in center, lefts on ends</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 dance-show-long-figure\">\n             <td>B2</td>\n             <td class=dance-show-beats>16</td>\n             <td><div class=\"show-figure\">partners balance &amp; swing</div>\n</td></tr>\n</tr></table>\n<div class=\"dance-show-notes\"><div class='contra-markdown-block'></div></div>\n<p class=\"dance-show-publish\">\n            shared everywhere\n          </p>\n"},"interpretation":{"becketWave":{"convention":"compact-becket-ordinary-hey-v1","sourceSnapshotId":"contradb:1844:f5375c54aafa7cb8"}}}