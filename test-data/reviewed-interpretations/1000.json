ance-show-beats>8</td>\n             <td><div class=\"show-figure\">ladles chain to neighbor</div>\n</td></tr>\n</tr>         <tr class=\"a2b2 \">\n             <td></td>\n             <td class=dance-show-beats>8</td>\n             <td><div class=\"show-figure\">star left - hands across - 4 places, <u>gentlespoons</u> look to next <u>star</u> for new neighbor <u>gentlespoon</u> with whom they'd <u>allemande</u> right ⁋</div>\n</td></tr>\n</tr></table>\n<div class=\"dance-show-notes\"><div class='contra-markdown-block'></div></div>\n<p class=\"dance-show-publish\">\n            shared everywhere\n          </p>\n"},"interpretation":{"rows":{"contradb:1000:row:4":{"chainHand":"left"},"contradb:1000:row:7":{"nextNeighborQualifier":"after-figure"}},"sourceHook":"retain-table-reversed-chain-star-hook"}}
